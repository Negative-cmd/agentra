{
  "name": "agentra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 0.0.0.0 --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "node scripts/next.mjs start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "node scripts/local-db.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.105.1",
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "@x402/extensions": "2.29.0",
    "@x402/fetch": "2.29.0",
    "@x402/next": "2.29.0",
    "dotenv": "18.0.9",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "ox": "1.8.12",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "siwe": "3.0.0",
    "viem": "2.57.14",
    "wagmi": "3.7.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "prisma": "6.19.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
