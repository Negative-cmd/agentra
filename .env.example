# Copy to .env for local development. Never commit real credentials.
# The included local database helper uses a localhost-only development database.
DATABASE_URL="postgresql://agentra:agentra_local_only@127.0.0.1:5432/agentra?schema=public"

# Exact public origin used to bind SIWE signatures and reject cross-origin writes.
APP_URL="http://localhost:3000"

# Base Sepolia is the default. Changing this requires restarting/rebuilding the app.
NEXT_PUBLIC_BASE_NETWORK="base-sepolia"
NEXT_PUBLIC_BASE_RPC_URL="https://sepolia.base.org"
BASE_RPC_URL="https://sepolia.base.org"
ENABLE_MAINNET_PAYMENTS="false"

# Set to a public wallet address YOU control to enable paid reference services.
# No private key or seed phrase belongs in this app or this file.
PAYMENT_RECIPIENT=""
X402_FACILITATOR_URL="https://x402.org/facilitator"

# Comma-separated public wallet addresses with administrative access.
# Leave empty for ordinary users only. Never expose this setting as NEXT_PUBLIC_.
ADMIN_WALLETS=""
# Exact curated public HTTPS provider hostnames eligible for manual admin approval.
# Submitted endpoints are never fetched automatically.
PROVIDER_ALLOWED_HOSTS=""
